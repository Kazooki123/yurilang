// Yuri grammar (v0.3)
//
// Source is preprocessed by `indent.rs` before reaching here: indentation
// is converted into explicit `{` / `}` tokens, and `?` comments are
// stripped there too. So this grammar only ever sees clean, brace-
// delimited, comment-free source, and can treat newlines as ordinary
// whitespace.
//
// A program is a sequence of top-level items: `@ship` function
// definitions and exactly one `@wlw` entry point, in any order.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

program = { SOI ~ item* ~ EOI }
item    = { ship_def | entry_block }

entry_block = { "@wlw" ~ ":" ~ block }
ship_def    = { "@ship" ~ ident ~ param_list ~ ":" ~ block }
param_list  = { ident* }

block = { "{" ~ statement* ~ "}" }

statement = {
    bond_stmt | confess_stmt | if_stmt | cling_stmt
  | awaken_stmt | promise_stmt | call_stmt
}

bond_stmt    = { "@bond" ~ ident ~ "=" ~ expr }
confess_stmt = { "@confess" ~ expr ~ ("," ~ expr)* }
if_stmt      = { "@jealous" ~ expr ~ ":" ~ block ~ ("@forgive" ~ ":" ~ block)? }
cling_stmt   = { "@cling" ~ expr ~ ":" ~ block }
awaken_stmt  = { "@awaken" ~ ident }
promise_stmt = { "@promise" ~ expr }
call_stmt    = { call_expr }

expr = { comparison }

comparison = { arith ~ (cmp_op ~ arith)? }
cmp_op     = { ">=" | "<=" | "==" | "!=" | ">" | "<" }

arith  = { term ~ (add_op ~ term)* }
add_op = { "plus" | "minus" }

term   = { atom ~ (mul_op ~ atom)* }
mul_op = { "times" | "divide" }

atom = { call_expr | float_lit | int_lit | string_lit | ident }

call_expr = { "@" ~ ident ~ "(" ~ arg_list? ~ ")" }
arg_list  = { expr ~ ("," ~ expr)* }

float_lit  = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
int_lit    = @{ ASCII_DIGIT+ }
string_lit = @{ "\"" ~ inner_str ~ "\"" }
inner_str  = @{ (escape | !("\"" | "\\") ~ ANY)* }
escape     = @{ "\\" ~ ANY }

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
