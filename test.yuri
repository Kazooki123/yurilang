@wlw:
    @yuri math
    @yuri citrus
    @yuri bloomintoyou
    
    @bond x = @add 5 3
    @confess "Result:" x

    @confess "Hello, World!"

    @bond nums = [[1, 2, 3]]
    @bond words = #[["hello", "world"]]

    @bond y = 2
    @sappho y:
        @poet 1:
            @confess "one"
        @poet 2:
            @confess "two"
        @poet _:
            @confess "something else"

    @persona Character:
        name
        age
        hobby
        crush

    @bond aiko = @new Character:
        name = "Aiko"
        age = 17
        hobby = "reading"
        crush = "Rei"

    @confess aiko.name
    @confess aiko.crush

    @yuzu_alone_after
    @mei_alone_after

    @bond feelings = [["distant", "confused", "realizing", "confessing"]]
    feelings @> @affect yuu_reacts



