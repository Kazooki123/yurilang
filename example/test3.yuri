@wlw:
    ? (--- @jam tests ---)
    @confess "--- @jam break ---"
    @bond i = 0
    @fate i < 10:
        @jealous i == 5:
            @jam
        @confess i
        @rebond i = i plus 1

    @confess "--- @jam pass ---"
    @cling 5:
        @bond r = @band i 1
        @jealous r == 0:
            @jam pass
        @confess "odd iteration"

    ? (--- @spectrum tests ---)
    @confess "--- @spectrum ---"
    @spectrum Feeling:
        confused
        curious
        nervous
        inlove
        certain

    @bond aiko = Feeling.confused
    @confess aiko

    @bond aiko = Feeling.inlove
    @confess aiko

    @sappho aiko:
        @poet "Feeling.confused":
            @confess "Still figuring it out."
        @poet "Feeling.inlove":
            @confess "Oh no. Oh no no no."
        @poet "Feeling.certain":
            @confess "She knows. Finally."
        @poet _:
            @confess "Somewhere in between."

    ? (--- spectrum + awakening ---)
    @awakening aiko
    @try:
        @bond aiko = Feeling.confused
    @catch err:
        @confess err
    @heal:
        @confess aiko
