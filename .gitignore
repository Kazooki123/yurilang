# ignore everything
*

!/**/*.gitignore
!/.dockerignore
!/.containerignore
!/.editorconfig
!/.gitmodules
!/Dockerfile
!/Containerfile
!/AUTHORS

# and then whitelist specific things
!/**/
!**/*.py
!**/*.rs
!**/*.zig
!**/*.lasm
!**/*.odin
!**/*.c
!**/*.h
!**/*.yml
!**/*.scm
!**/*.md
!**/*.yuri
!**/*.toml
!**/*.pest
!**/*.htm
!**/*.html
!**/*.css
!*.txt
!**/*.png
!**/*.jpg
!**/*.ico
!**/*.json
!*.sh
!*.bat
!/amy/
!/extension/vscode/yurilang/
!/pkg/**
!/bin/libflac.dll
!/extension/**

!/.github/
!/**/LICENSE
!/**/Makefile

# ignore build & unnecessary directories
/build/
/dump/
/.idea/
/.zed/
/.vscode/
/pkm/test/
/extension/
/bin/

# Added by cargo

/target
